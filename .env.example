# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Only the variable NAMES live here. Share actual keys with teammates over a
# private channel (Discord DM, not the repo or #general).
#
# Everything is SERVER-SIDE only unless it starts with VITE_. Anything with a
# browser-exposed prefix (the NEXT_PUBLIC / VITE / REACT_APP / EXPO_PUBLIC family)
# gets bundled into the app and every player can read it, so only values that are
# public by design (like k-ID's publishable key) may use one.

# k-ID in the browser (companion age gate, @k-id/core). Public by design, but the
# values still stay out of the repo. Starts with kgp_test_ for a test key.
VITE_KID_PUBLISHABLE_KEY=
VITE_KID_BASE_URL=https://kai-api.test.k-id.com/fapi/v1
# Required by k-ID: shown to parents and players in k-ID's emails
VITE_KID_SUPPORT_EMAIL=

# k-ID on the server: age sessions and purchase approval
# KID_API_KEY is the SECRET key from Compliance Studio > Developer Settings,
# not the kgp_ publishable key above.
# Test mode base URL; the live one is https://game-api.k-id.com
KID_API_BASE_URL=https://game-api.test.k-id.com
KID_API_KEY=
KID_PRODUCT_ID=
# Secret k-ID uses to sign webhooks (Compliance Studio > Developer Settings)
KID_WEBHOOK_SECRET=

# Inworld (TTS / STT / realtime voice): one shared team workspace
INWORLD_API_KEY=

# Modulate (voice understanding / moderation)
MODULATE_API_KEY=

# FastSpring sandbox (test transactions only)
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
# Popup storefront for Store Builder Library's data-storefront (nonsecret), in the
# form <store>.test.onfastspring.com/popup-<checkout>. The Sessions API's
# checkoutPath is the same pair written as <store>/popup-<checkout>.
FASTSPRING_STOREFRONT=
# HMAC secret set on the FastSpring webhook (Developer Tools > Webhooks)
FASTSPRING_WEBHOOK_SECRET=

# Gemini: SDK/model configuration must be confirmed by the W06 owner.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local foundation connections (nonsecret; no provider calls are made).
API_PORT=8787
COMPANION_PORT=5173
BEACON_COMPANION_ORIGIN=http://127.0.0.1:5173
# Optional exact extension origins, comma separated; empty is fine for the shell.
BEACON_EXTENSION_ORIGINS=
